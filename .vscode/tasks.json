{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Checks: format+lint+type+test (host/Codespaces)",
      "type": "shell",
      "command": "python -m ruff format --check . && python -m ruff check . && python -m mypy && python -m pytest",
      "problemMatcher": []
    },
    {
      "label": "Format: ruff (host/Codespaces)",
      "type": "shell",
      "command": "python -m ruff format ."
    },
    {
      "label": "Lint: ruff (host/Codespaces)",
      "type": "shell",
      "command": "python -m ruff check ."
    },
    {
      "label": "Typecheck: mypy (host/Codespaces)",
      "type": "shell",
      "command": "python -m mypy"
    },
    {
      "label": "Test: pytest (host/Codespaces)",
      "type": "shell",
      "command": "python -m pytest"
    },
    {
      "label": "Test: docker compose api-test (local)",
      "type": "shell",
      "command": "docker compose run --rm --build api-test",
      "problemMatcher": []
    }
  ]
}

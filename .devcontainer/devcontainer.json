{
  "name": "supportdesk-api",
  "dockerComposeFile": "../docker-compose.yml",
  "service": "api",
  "workspaceFolder": "/app",
  "shutdownAction": "stopCompose",
  "runServices": [
    "db",
    "api"
  ],
  "forwardPorts": [
    8080
  ],
  "portsAttributes": {
    "8080": {
      "label": "API (FastAPI)"
    }
  },
  "postCreateCommand": "python -m pip install -U pip && python -m pip install -r requirements-dev.txt && python -m pip install --no-deps .",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  },
  "overrideCommand": false
}
